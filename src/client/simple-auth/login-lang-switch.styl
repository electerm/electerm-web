.login-controls
  position fixed
  top 12px
  right 14px
  z-index 10
  display flex
  align-items center
  gap 6px

.login-theme-toggle,
.login-lang-switch
  display flex
  align-items center
  background var(--main-light)
  border 1px solid var(--main-dark)
  border-radius 100px

.login-theme-toggle
  justify-content center
  width 34px
  height 34px
  color var(--text)
  cursor pointer

.login-theme-toggle:hover
  color var(--primary)

.login-theme-toggle:focus-visible
  outline 2px solid var(--primary)
  outline-offset 2px

.login-lang-switch
  gap 2px
  padding 3px

.login-lang-btn
  appearance none
  border 0
  background transparent
  padding 4px 10px
  border-radius 100px
  font-size .78rem
  line-height 1.4
  font-family inherit
  color var(--text-light)
  cursor pointer
  transition background .2s, color .2s

.login-lang-btn:hover
  color var(--text)

.login-lang-btn-active
  background var(--primary)
  color var(--primary-contrast)

.login-lang-btn-active:hover
  color var(--primary-contrast)

@media screen and (max-width 479px)
  .login-controls
    top 8px
    right 10px
