// Hero of the pre-login screens, ported from electerm.org
// (src/css/parts/hero.styl). It deliberately has no background of its own:
// the starfield (.login-bg) is the page background and shows through the
// whole hero, which is also why there is no white .hero background here.
.login-hero
  position relative
  // flex none: the page is a fixed-height flex column, so a shrinkable hero
  // would be squashed (and clipped) instead of scrolling the page
  flex none
  padding 44px 16px 28px
  text-align center

// faint brand wash at the top - electerm.org's .hero::before, retinted with
// the app's primary instead of the site's own blue
.login-hero::before
  content ''
  position absolute
  inset 0
  background radial-gradient(ellipse at 50% 0%, rgba(0, 136, 204, .07) 0%, rgba(0, 136, 204, 0) 70%)
  pointer-events none
  z-index 0

.login-hero-inner
  position relative
  z-index 1
  max-width 720px
  margin 0 auto
  display flex
  flex-direction column
  align-items center

.login-hero-brand
  position relative
  z-index 2
  line-height 0
  margin-bottom 8px

// the wordmark carries the title visually; the h1 is for screen readers and
// search engines only, exactly as on electerm.org
.login-hero-title
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip-path inset(50%)
  white-space nowrap
  border 0

.login-hero-tagline
  font-size 1.15rem
  color var(--text)
  max-width 560px
  margin 0 0 8px
  line-height 1.7

.login-hero-supports
  font-size .92rem
  color var(--text-light)
  max-width 640px
  margin 0 0 18px
  line-height 1.65

.login-hero-version
  display inline-flex
  align-items center
  gap 8px
  padding 6px 14px
  background #f1f5f9
  border-radius 100px
  font-size .85rem
  color var(--text-light)

.login-hero-dot
  width 7px
  height 7px
  border-radius 50%
  background var(--success)
  animation login-hero-pulse 2s infinite

@keyframes login-hero-pulse
  0%, 100%
    opacity 1
  50%
    opacity .5

@media (max-width 479px)
  .login-hero
    padding 30px 14px 24px
  .login-hero-tagline
    font-size 1rem
  .login-hero-supports
    font-size .85rem

@media (prefers-reduced-motion: reduce)
  .login-hero-dot
    animation none
