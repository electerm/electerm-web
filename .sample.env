# run `cp .sample.env .env` to create your local env

# production server config
HOST=127.0.0.1
PORT=5577
# SERVER=http://xxx.com
# CDN=http://xxx.com
#BASE_PATH=/sub # common same-origin path prefix applied to api, websocket and static asset urls (e.g. when served under a reverse-proxy sub-path)
# Leave ENABLE_AUTH unset for open access. To require a password, uncomment it
# and set SERVER_PASS. Any nonempty ENABLE_AUTH value enables login.
# ENABLE_AUTH=1
SERVER_PASS=
# Optional: pin the browser-facing HTTPS origin. Otherwise match the request Host.
# PUBLIC_ORIGIN=https://electerm.example.org
# DISABLE_LOCAL_TERMINAL=1
SERVER_USER=default_user
# DB_PATH=/some/custom-path-to-db-folder
#
# to use same data as desktop electerm
# for Mac OS DB_PATH="/Users/<your-user-name>/Library/Application Support/electerm"
# for Linux OS DB_PATH="/home/<your-user-name>/.config/electerm"
# for Windows OS DB_PATH="C:\\Users\\<your-user-name>\\AppData\\Roaming\\electerm"

# dev server host port
DEV_HOST=127.0.0.1
DEV_PORT=5580
